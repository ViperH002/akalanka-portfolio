# ==============================================================================
# AI Portfolio Assistant & Platform Configuration Template
# ==============================================================================

# --- LLM Provider Configuration ---
# Supports Anthropic Claude, OpenAI-compatible APIs, and Google Gemini.
# If multiple are provided, the system prioritizes Anthropic / OpenAI.

# Option A: Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Option B: OpenAI or OpenAI-Compatible (Groq, Perplexity, OpenRouter, Local Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Option C: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- ElevenLabs Text-to-Speech Configuration ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_STABILITY=0.72
ELEVENLABS_SIMILARITY=0.85
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEAKER_BOOST=true

# --- Security & Rate Limiting ---
RATE_LIMIT_CHAT_PER_MINUTE=25
RATE_LIMIT_TTS_PER_MINUTE=15

# --- Distributed Cache & Rate Limiting (Upstash Redis) ---
# Optional: If unconfigured, automatically falls back to in-memory sliding window
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin Authentication & Session Security ---
# Secret clearance passkey for /admin dashboard (default: admin2026 if unset)
ADMIN_SECRET_KEY=admin2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# High-entropy signing secret (32+ chars) used for HMAC-SHA256 session tokens
SESSION_SECRET=devcraft-super-secret-production-signing-key-change-in-production-32chars

# --- Email Notifications (Resend API) ---
# Optional: Inquiries are persistently buffered in data/leads.json regardless of email API status
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@akviper.xyz
ADMIN_NOTIFICATION_EMAIL=contact@akviper.xyz

# --- Developer Telemetry & Activity (GitHub / WakaTime) ---
GITHUB_TOKEN=
GITHUB_USERNAME=ViperH002
WAKATIME_API_KEY=
